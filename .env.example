# =============================================================================
# AutoNexa Top-Level / Docker Compose Environment Template
# =============================================================================
# Copy this file to .env before running `docker-compose up`.
# Generate unique production keys using: `openssl rand -hex 24`

# Mandatory production secrets for backend authentication (minimum 16 chars)
AUTONEXA_API_KEY_READ=replace_with_strong_read_key_32chars_hex
AUTONEXA_API_KEY_ADMIN=replace_with_strong_admin_key_32chars_hex

# Public API Base URL for frontend client routing
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
