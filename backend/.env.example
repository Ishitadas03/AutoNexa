# AutoNexa / AutoML Research Lab - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Application Configuration
PROJECT_NAME="AutoML Research Lab"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
RELOAD=true

# Storage & File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# CORS Configuration (comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
