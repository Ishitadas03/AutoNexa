# =============================================================================
# AutoNexa Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or production credentials to version control.
# In production, ENVIRONMENT=production enforces fail-closed security controls.

# -----------------------------------------------------------------------------
# 1. Application & Runtime Configuration
# -----------------------------------------------------------------------------
APP_NAME=AutoNexa
APP_VERSION=0.1.0
APP_DESCRIPTION="An automated machine-learning research platform for tabular datasets."

# Runtime Environment: 'development', 'staging', or 'production'
# CRITICAL: Setting ENVIRONMENT=production enforces fail-closed authentication:
# - API_AUTH_ENABLED cannot be disabled.
# - API_KEY_ADMIN and API_KEY_READ must be distinct, non-default, and >= 16 chars.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# 2. Server Binding & Network Configuration
# -----------------------------------------------------------------------------
# Use 127.0.0.1 for local host-bound development; use 0.0.0.0 for containerized deployment
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Cross-Origin Resource Sharing (CORS)
# JSON-encoded array of allowed client origins. In production, restrict to your verified frontend domain.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# 3. Persistent Storage Paths & Mount Points
# -----------------------------------------------------------------------------
# MANDATORY OPERATIONAL REQUIREMENT:
# In containerized environments, these directories MUST be mapped to persistent volumes.
# SQLite database, uploaded datasets, and model binaries do NOT persist on ephemeral filesystems.
UPLOAD_DIR=uploads
EXPERIMENTS_DIR=experiments
METADATA_DB_PATH=data/metadata.db
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB default limit

# -----------------------------------------------------------------------------
# 4. Authentication & Access Control (Phase 16B Security)
# -----------------------------------------------------------------------------
API_AUTH_ENABLED=true

# Read-only / Inference API Key:
# Used for metadata inspection, health readiness checks, and prediction serving.
# For local development: autonexa-read-key-secret (default)
# For production: MUST be generated via `openssl rand -hex 24` (min 16 chars, non-default)
API_KEY_READ=autonexa-read-key-secret

# Admin / Operator API Key:
# Used for dataset upload/deletion, pipeline creation, and model promotion.
# For local development: autonexa-admin-key-secret (default)
# For production: MUST be generated via `openssl rand -hex 24` (min 16 chars, distinct from read key)
API_KEY_ADMIN=autonexa-admin-key-secret

# Model serving stages allowed for prediction traffic (comma-separated or JSON list)
SERVING_ELIGIBLE_STAGES=["production","staging"]
SERVING_CACHE_MAX_MODELS=20

# -----------------------------------------------------------------------------
# 5. Resource Limits & Pipeline Orchestration
# -----------------------------------------------------------------------------
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=500
MAX_TRAINING_BUDGET_SECONDS=300
PIPELINE_MAX_CONCURRENCY=2
PIPELINE_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# 6. Model Monitoring & Drift Detection
# -----------------------------------------------------------------------------
MONITORING_MAX_RECORDS_PER_WINDOW=5000
MONITORING_MIN_SAMPLES_DRIFT=30
MONITORING_PSI_WARNING_THRESHOLD=0.1
MONITORING_PSI_CRITICAL_THRESHOLD=0.2
MONITORING_KS_PVALUE_THRESHOLD=0.05
