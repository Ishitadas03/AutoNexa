# AutoNexa - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Application Configuration
APP_NAME=AutoNexa
APP_VERSION=0.1.0
APP_DESCRIPTION="An automated machine-learning research platform for tabular datasets."
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Storage & Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB

# AutoML Training & Resource Limits
EXPERIMENTS_DIR=experiments
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=500
MAX_TRAINING_BUDGET_SECONDS=300

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
