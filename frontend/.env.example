# =============================================================================
# AutoNexa Frontend - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel or production hosting, set these in the project environment dashboard.

# -----------------------------------------------------------------------------
# 1. Backend API Base URL & Server-Side BFF Proxy Target
# -----------------------------------------------------------------------------
# Local development default: http://127.0.0.1:8000
# Production requirement: Full HTTPS URL of your deployed AutoNexa backend API.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 2. Server-Side Authentication Credentials (BFF Proxy)
# -----------------------------------------------------------------------------
# These keys are read exclusively by the Next.js server-side route handlers
# (/api/datasets/upload and /api/bff/*) and are NEVER exposed to the browser client.
# In Vercel, configure these under Project Settings -> Environment Variables.
AUTONEXA_API_KEY_ADMIN=autonexa-admin-key-secret
AUTONEXA_API_KEY_READ=autonexa-read-key-secret

# -----------------------------------------------------------------------------
# CRITICAL SECURITY NOTICE
# -----------------------------------------------------------------------------
# NEVER prefix API keys with NEXT_PUBLIC_*!
# ANY variable prefixed with NEXT_PUBLIC_* is compiled directly into browser client
# JavaScript bundles and will be publicly exposed to any visitor.
