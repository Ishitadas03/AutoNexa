# =============================================================================
# AutoNexa Frontend - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel or production hosting, set these in the project environment dashboard.

# -----------------------------------------------------------------------------
# 1. Backend API Base URL
# -----------------------------------------------------------------------------
# Local development default: http://127.0.0.1:8000
# Production requirement: Full HTTPS URL of your deployed AutoNexa backend API.
# Note: In production, frontend will fail fast with HTTP 503 if this is unconfigured.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# CRITICAL SECURITY NOTICE
# -----------------------------------------------------------------------------
# NEVER add API_KEY_ADMIN, API_KEY_READ, or backend credentials to this file!
# ANY variable prefixed with NEXT_PUBLIC_* is compiled directly into browser client
# JavaScript bundles and will be publicly exposed to any visitor.
#
# AutoNexa clients provide read/admin keys interactively via the UI header, which
# stores them securely in the user's browser localStorage.
